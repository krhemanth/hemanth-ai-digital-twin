OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_GUARD_MODEL=gpt-5.4-nano

PUSHOVER_USER=
PUSHOVER_TOKEN=
OWNER_EMAIL=

# For Hugging Face, add the complete contents of gmail_token.json as a Secret.
GMAIL_OAUTH_TOKEN_JSON=

# Local-only OAuth alternatives. Never commit these JSON files.
GMAIL_OAUTH_CLIENT_FILE=gmail_client_secret.json
GMAIL_OAUTH_TOKEN_FILE=gmail_token.json
GMAIL_ALLOW_INTERACTIVE_OAUTH=false

# Optional SMTP fallback.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=

# Use /data only when a persistent Hugging Face volume/bucket is mounted there.
TWIN_DATA_DIR=
GRADIO_INBROWSER=false
GRADIO_SHARE=false

# Render supplies PORT and RENDER automatically. For another container host, set:
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SERVER_PORT=7860
